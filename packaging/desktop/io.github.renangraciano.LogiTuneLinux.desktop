[Desktop Entry]
Type=Application
Version=1.0
Name=Logi Tune Linux
GenericName=Mouse Settings
Comment=Configure your Logitech MX Master mouse
Comment[pt_BR]=Configure seu mouse Logitech MX Master
Exec=logitune-gui
Icon=io.github.renangraciano.LogiTuneLinux
Terminal=false
Categories=Settings;HardwareSettings;GTK;
Keywords=mouse;logitech;mx;master;dpi;scroll;pointer;hid;
Keywords[pt_BR]=mouse;logitech;mx;master;dpi;rolagem;ponteiro;
# Casa a janela GTK com esta entrada, para que o ícone certo apareça no dock.
StartupWMClass=logitune-gui
StartupNotify=true
